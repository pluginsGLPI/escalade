#: templates/eol_info.html.twig inc/eolinfo.class.php:57 front/eol_info.php:34
msgid "Escalade (End Of Life)"
msgstr "Escalade (Fim de vida útil)"

#: templates/eol_info.html.twig templates/migration_status.html.twig
#, php-format
msgid ""
"Escalade v%s is End-of-Life: its features are now provided by the "
"MoreOptions plugin."
msgstr "O Escalade v%s atingiu o fim de sua vida útil: suas funcionalidades agora são oferecidas pelo plugin MoreOptions."

#: templates/eol_info.html.twig
msgid "What changed?"
msgstr "O que mudou?"

#: templates/eol_info.html.twig
msgid "Escalation is provided by MoreOptions"
msgstr "O escalonamento é fornecido pelo MoreOptions"

#: templates/eol_info.html.twig
msgid "Escalation tree by entity"
msgstr "Árvore de escalonamento por entidade"

#: templates/eol_info.html.twig
msgid "Filter bypass by profile"
msgstr "Ignorar filtros por perfil"

#: templates/eol_info.html.twig
msgid "Next steps"
msgstr "Próximos passos"

#: templates/eol_info.html.twig
msgid "Enable MoreOptions"
msgstr "Habilitar o MoreOptions"

#: templates/eol_info.html.twig
msgid "Run the migration"
msgstr "Execute a migração"

#: templates/eol_info.html.twig
msgid "Uninstall Escalade"
msgstr "Desinstalar o Escalade"

#: templates/eol_info.html.twig
msgid "View Migration Status"
msgstr "Ver status de migração"

#: templates/migration_status.html.twig front/migration_status.php:39
msgid "Escalade migration status"
msgstr "Status de migração do Escalade"

#: templates/migration_status.html.twig inc/eolinfo.class.php:139
msgid ""
"Install and enable the MoreOptions plugin before running the migration."
msgstr "Instale e ative o plugin MoreOptions antes de executar a migração."

#: templates/migration_status.html.twig
msgid "Migration Status"
msgstr "Status da migração"

#: templates/migration_status.html.twig
msgid "Group filter"
msgstr "Filtro de grupo"

#: templates/migration_status.html.twig
msgid "Active"
msgstr "Ativo"

#: templates/migration_status.html.twig
msgid "Inactive"
msgstr "Inativo"

#: templates/migration_status.html.twig
msgid "Migrated links"
msgstr "Links migrados"

#: templates/migration_status.html.twig
msgid "Users bypassing the filter"
msgstr "Usuários contornando o filtro"

#: templates/migration_status.html.twig
msgid "Source group"
msgstr "Grupo de origem"

#: templates/migration_status.html.twig
msgid "Destination group"
msgstr "Grupo de destino"

#: templates/migration_status.html.twig
msgid "Status"
msgstr "Status"

#: templates/migration_status.html.twig
msgid "Migrated"
msgstr "Migrado"

#: templates/migration_status.html.twig
msgid "Not Migrated"
msgstr "Não migrado"

#: templates/migration_status.html.twig
msgid "No escalation link to migrate."
msgstr "Não há link de escalonamento para migrar."

#: templates/migration_status.html.twig
msgid "How to Migrate"
msgstr "Como migrar"

#: templates/migration_status.html.twig
msgid "Simulate"
msgstr "Simular"

#: templates/migration_status.html.twig
msgid "Migrate"
msgstr "Migrar"

#: templates/migration_status.html.twig
msgid "Or from the command line:"
msgstr "Ou, a partir da linha de comando:"

#: templates/migration_status.html.twig
msgid "Copy command"
msgstr "Copiar comando"

#: templates/migration_status.html.twig
msgid "From the GLPI root directory. Add \"--dry-run\" to simulate."
msgstr "A partir do diretório raiz do GLPI. Adicione \"--dry-run\" para realizar uma simulação."

#: templates/migration_status.html.twig
msgid "Links are migrated to the root entity and inherited by sub-entities"
msgstr "Os links são migrados para a entidade raiz e herdados pelas subentidades."

#: templates/migration_status.html.twig
msgid ""
"Users bypassing the filter cannot be migrated: allow profiles in MoreOptions"
" instead"
msgstr "Usuários que contornam o filtro não podem ser migrados: em vez disso, permita perfis no MoreOptions"

#: templates/migration_status.html.twig
msgid "Migrate the group filter to MoreOptions?"
msgstr "Migrar o filtro de grupo para o MoreOptions?"

#: inc/eolinfo.class.php:167
msgid "The migration failed, all changes have been reverted."
msgstr "A migração falhou, todas as alterações foram revertidas."

#: inc/eolinfo.class.php:169
#, php-format
msgid ""
"Simulation: %1$d items would be created, %2$d reused. Nothing has been "
"changed."
msgstr "Simulação: %1$d itens seriam criados, %2$d reutilizados. Nada foi alterado."

#: inc/eolinfo.class.php:171
#, php-format
msgid "Migration done: %1$d items created, %2$d reused."
msgstr "Migração concluída: %1$d itens criados, %2$d reutilizados."

#: inc/eolinfo.class.php:236 inc/eolinfo.class.php:237
#, php-format
msgid "Deleted group #%d"
msgstr "Grupo excluído nº%d"

#: setup.php:68
msgid "Escalade End-Of-Life Updater"
msgstr "Atualizador para o fim da vida útil do Escalade"
