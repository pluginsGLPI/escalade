#: templates/eol_info.html.twig front/eol_info.php:34 inc/eolinfo.class.php:57
msgid "Escalade (End Of Life)"
msgstr "Eskalácie (koniec životnosti)"

#: templates/eol_info.html.twig templates/migration_status.html.twig
#, php-format
msgid ""
"Escalade v%s is End-of-Life: its features are now provided by the "
"MoreOptions plugin."
msgstr "Escalade v%s je na konci životnosti: jeho funkcie teraz poskytuje plugin MoreOptions."

#: templates/eol_info.html.twig
msgid "What changed?"
msgstr "Čo sa zmenilo?"

#: templates/eol_info.html.twig
msgid "Escalation is provided by MoreOptions"
msgstr "Eskaláciu teraz poskytuje plugin MoreOptions."

#: templates/eol_info.html.twig
msgid "Escalation tree by entity"
msgstr "Strom eskalácií podľa entity"

#: templates/eol_info.html.twig
msgid "Filter bypass by profile"
msgstr "Obídenie filtra podľa profilu"

#: templates/eol_info.html.twig
msgid "Next steps"
msgstr "Ďalšie kroky"

#: templates/eol_info.html.twig
msgid "Enable MoreOptions"
msgstr "Povoliť MoreOptions"

#: templates/eol_info.html.twig
msgid "Run the migration"
msgstr "Spustiť migráciu"

#: templates/eol_info.html.twig
msgid "Uninstall Escalade"
msgstr "Odinštalovať Escalade"

#: templates/eol_info.html.twig
msgid "View Migration Status"
msgstr "Zobraziť stav migrácie"

#: templates/migration_status.html.twig front/migration_status.php:39
msgid "Escalade migration status"
msgstr "Stav migrácie Escalade"

#: templates/migration_status.html.twig inc/eolinfo.class.php:139
msgid ""
"Install and enable the MoreOptions plugin before running the migration."
msgstr "Pred spustením migrácie nainštalujte a povoľte plugin MoreOptions."

#: templates/migration_status.html.twig
msgid "Migration Status"
msgstr "Stav migrácie"

#: templates/migration_status.html.twig
msgid "Group filter"
msgstr "Filter skupín"

#: templates/migration_status.html.twig
msgid "Active"
msgstr "Aktívne"

#: templates/migration_status.html.twig
msgid "Inactive"
msgstr "Neaktívne"

#: templates/migration_status.html.twig
msgid "Migrated links"
msgstr "Migrované odkazy"

#: templates/migration_status.html.twig
msgid "Users bypassing the filter"
msgstr "Používatelia obchádzajúci filter"

#: templates/migration_status.html.twig
msgid "Source group"
msgstr "Zdrojová skupina"

#: templates/migration_status.html.twig
msgid "Destination group"
msgstr "Cieľová skupina"

#: templates/migration_status.html.twig
msgid "Status"
msgstr "Stav"

#: templates/migration_status.html.twig
msgid "Migrated"
msgstr "Migrované"

#: templates/migration_status.html.twig
msgid "Not Migrated"
msgstr "Nemigrované"

#: templates/migration_status.html.twig
msgid "No escalation link to migrate."
msgstr "Žiadne prepojenie na eskaláciu na migráciu."

#: templates/migration_status.html.twig
msgid "How to Migrate"
msgstr "Ako migrovať"

#: templates/migration_status.html.twig
msgid "Simulate"
msgstr "Simulovať"

#: templates/migration_status.html.twig
msgid "Migrate the group filter to MoreOptions?"
msgstr "Migrovať filter skupiny do pluginu MoreOptions?"

#: templates/migration_status.html.twig
msgid "Migrate"
msgstr "Migrovať"

#: templates/migration_status.html.twig
msgid "Or from the command line:"
msgstr "Alebo z príkazového riadka:"

#: templates/migration_status.html.twig
msgid "Copy command"
msgstr "Skopírovať príkaz"

#: templates/migration_status.html.twig
msgid "From the GLPI root directory. Add \"--dry-run\" to simulate."
msgstr "Spustite z koreňového adresára GLPI. Na simuláciu pridajte parameter --dry-run."

#: templates/migration_status.html.twig
msgid "Links are migrated to the root entity and inherited by sub-entities"
msgstr "Prepojenia sa migrujú do koreňovej entity a dedia sa do podradených entít"

#: templates/migration_status.html.twig
msgid ""
"Users bypassing the filter cannot be migrated: allow profiles in MoreOptions"
" instead"
msgstr "Používatelia, ktorí obchádzajú filter, sa nedajú migrovať: namiesto toho povoľte profily v MoreOptions."

#: setup.php:68
msgid "Escalade End-Of-Life Updater"
msgstr "Aktualizátor koniec životnosti Escalade"

#: inc/eolinfo.class.php:167
msgid "The migration failed, all changes have been reverted."
msgstr "Migrácia zlyhala, všetky zmeny boli vrátené späť."

#: inc/eolinfo.class.php:169
#, php-format
msgid ""
"Simulation: %1$d items would be created, %2$d reused. Nothing has been "
"changed."
msgstr "Simulácia: boli by vytvorené položky: %1$d, znovu použité: %2$d. Nič sa nezmenilo."

#: inc/eolinfo.class.php:171
#, php-format
msgid "Migration done: %1$d items created, %2$d reused."
msgstr "Migrácia dokončená: položky vytvorené: %1$d, znovu použité: %2$d."

#: inc/eolinfo.class.php:236 inc/eolinfo.class.php:237
#, php-format
msgid "Deleted group #%d"
msgstr "Odstránená skupina č. %d"
