#: templates/eol_info.html.twig front/eol_info.php:34 inc/eolinfo.class.php:57
msgid "Escalade (End Of Life)"
msgstr "Escalade (fin de ciclo de vida)"

#: templates/eol_info.html.twig templates/migration_status.html.twig
#, php-format
msgid ""
"Escalade v%s is End-of-Life: its features are now provided by the "
"MoreOptions plugin."
msgstr "Escalade v%s llegó al final de su ciclo de vida: sus funciones ahora las ofrece el plugin MoreOptions."

#: templates/eol_info.html.twig
msgid "What changed?"
msgstr "¿Qué cambió?"

#: templates/eol_info.html.twig
msgid "Escalation is provided by MoreOptions"
msgstr "El escalamiento ahora lo proporciona MoreOptions"

#: templates/eol_info.html.twig
msgid "Escalation tree by entity"
msgstr "Árbol de escalamiento por entidad"

#: templates/eol_info.html.twig
msgid "Filter bypass by profile"
msgstr "Omisión del filtro por perfil"

#: templates/eol_info.html.twig
msgid "Next steps"
msgstr "Siguientes pasos"

#: templates/eol_info.html.twig
msgid "Enable MoreOptions"
msgstr "Habilitar MoreOptions"

#: templates/eol_info.html.twig
msgid "Run the migration"
msgstr "Ejecutar la migración"

#: templates/eol_info.html.twig
msgid "Uninstall Escalade"
msgstr "Desinstalar Escalade"

#: templates/eol_info.html.twig
msgid "View Migration Status"
msgstr "Ver estado de la migración"

#: templates/migration_status.html.twig front/migration_status.php:39
msgid "Escalade migration status"
msgstr "Estado de la migración de Escalade"

#: templates/migration_status.html.twig inc/eolinfo.class.php:139
msgid ""
"Install and enable the MoreOptions plugin before running the migration."
msgstr "Instale y habilite el plugin MoreOptions antes de ejecutar la migración."

#: templates/migration_status.html.twig
msgid "Migration Status"
msgstr "Estado de la migración"

#: templates/migration_status.html.twig
msgid "Group filter"
msgstr "Filtro de grupos"

#: templates/migration_status.html.twig
msgid "Active"
msgstr "Activo"

#: templates/migration_status.html.twig
msgid "Inactive"
msgstr "Inactivo"

#: templates/migration_status.html.twig
msgid "Migrated links"
msgstr "Enlaces migrados"

#: templates/migration_status.html.twig
msgid "Users bypassing the filter"
msgstr "Usuarios que omiten el filtro"

#: templates/migration_status.html.twig
msgid "Source group"
msgstr "Grupo de origen"

#: templates/migration_status.html.twig
msgid "Destination group"
msgstr "Grupo de destino"

#: templates/migration_status.html.twig
msgid "Status"
msgstr "Estado"

#: templates/migration_status.html.twig
msgid "Migrated"
msgstr "Migrado"

#: templates/migration_status.html.twig
msgid "Not Migrated"
msgstr "No migrado"

#: templates/migration_status.html.twig
msgid "No escalation link to migrate."
msgstr "No hay enlaces de escalamiento por migrar."

#: templates/migration_status.html.twig
msgid "How to Migrate"
msgstr "Cómo migrar"

#: templates/migration_status.html.twig
msgid "Simulate"
msgstr "Simular"

#: templates/migration_status.html.twig
msgid "Migrate the group filter to MoreOptions?"
msgstr "¿Migrar el filtro de grupos a MoreOptions?"

#: templates/migration_status.html.twig
msgid "Migrate"
msgstr "Migrar"

#: templates/migration_status.html.twig
msgid "Or from the command line:"
msgstr "O desde la línea de comandos:"

#: templates/migration_status.html.twig
msgid "Copy command"
msgstr "Copiar comando"

#: templates/migration_status.html.twig
msgid "From the GLPI root directory. Add \"--dry-run\" to simulate."
msgstr "Desde el directorio raíz de GLPI. Agregue \"--dry-run\" para simular."

#: templates/migration_status.html.twig
msgid "Links are migrated to the root entity and inherited by sub-entities"
msgstr "Los enlaces se migran a la entidad raíz y las subentidades los heredan"

#: templates/migration_status.html.twig
msgid ""
"Users bypassing the filter cannot be migrated: allow profiles in MoreOptions"
" instead"
msgstr "Los usuarios que omiten el filtro no se pueden migrar: en su lugar, permita perfiles en MoreOptions"

#: setup.php:68
msgid "Escalade End-Of-Life Updater"
msgstr "Actualizador de fin de ciclo de vida de Escalade"

#: inc/eolinfo.class.php:167
msgid "The migration failed, all changes have been reverted."
msgstr "La migración falló; se revirtieron todos los cambios."

#: inc/eolinfo.class.php:169
#, php-format
msgid ""
"Simulation: %1$d items would be created, %2$d reused. Nothing has been "
"changed."
msgstr "Simulación: se crearían %1$d elementos y se reutilizarían %2$d. No se modificó nada."

#: inc/eolinfo.class.php:171
#, php-format
msgid "Migration done: %1$d items created, %2$d reused."
msgstr "Migración completada: %1$d elementos creados y %2$d reutilizados."

#: inc/eolinfo.class.php:236 inc/eolinfo.class.php:237
#, php-format
msgid "Deleted group #%d"
msgstr "Grupo #%d eliminado"
