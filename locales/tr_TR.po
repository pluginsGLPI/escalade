#: templates/eol_info.html.twig front/eol_info.php:34 inc/eolinfo.class.php:57
msgid "Escalade (End Of Life)"
msgstr "Escalade (ömrü tamamlandı)"

#: templates/eol_info.html.twig templates/migration_status.html.twig
#, php-format
msgid ""
"Escalade v%s is End-of-Life: its features are now provided by the "
"MoreOptions plugin."
msgstr "Escalade v%s ömrünün sonuna geldi: Onun özellikleri artık MoreOptions eklentisi tarafından sağlanıyor."

#: templates/eol_info.html.twig
msgid "What changed?"
msgstr "Neler değişti?"

#: templates/eol_info.html.twig
msgid "Escalation is provided by MoreOptions"
msgstr "Üste aktarma işlemleri MoreOptions tarafından sağlanıyor"

#: templates/eol_info.html.twig
msgid "Escalation tree by entity"
msgstr "Birime göre üste aktarma ağacı"

#: templates/eol_info.html.twig
msgid "Filter bypass by profile"
msgstr "Profile göre süzgeçten geçme"

#: templates/eol_info.html.twig
msgid "Next steps"
msgstr "Sonraki adımlar"

#: templates/eol_info.html.twig
msgid "Enable MoreOptions"
msgstr "MoreOptions eklentisini kullanıma alın"

#: templates/eol_info.html.twig
msgid "Run the migration"
msgstr "Aktarımı çalıştırın"

#: templates/eol_info.html.twig
msgid "Uninstall Escalade"
msgstr "Escalade eklentisini kaldırın"

#: templates/eol_info.html.twig
msgid "View Migration Status"
msgstr "Aktarım durumunu görüntüle"

#: templates/migration_status.html.twig front/migration_status.php:39
msgid "Escalade migration status"
msgstr "Escalade aktarım durumu"

#: templates/migration_status.html.twig inc/eolinfo.class.php:139
msgid ""
"Install and enable the MoreOptions plugin before running the migration."
msgstr "Aktarıcıyı çalıştırmadan önce MoreOptions eklentisini kurun ve kullanıma alın."

#: templates/migration_status.html.twig
msgid "Migration Status"
msgstr "Aktarım durumu"

#: templates/migration_status.html.twig
msgid "Group filter"
msgstr "Grup süzgeci"

#: templates/migration_status.html.twig
msgid "Active"
msgstr "Etkin"

#: templates/migration_status.html.twig
msgid "Inactive"
msgstr "Etkisiz"

#: templates/migration_status.html.twig
msgid "Migrated links"
msgstr "Aktarılan bağlantılar"

#: templates/migration_status.html.twig
msgid "Users bypassing the filter"
msgstr "Süzgeçten geçen kullanıcılar"

#: templates/migration_status.html.twig
msgid "Source group"
msgstr "Kaynak grup"

#: templates/migration_status.html.twig
msgid "Destination group"
msgstr "Hedef grup"

#: templates/migration_status.html.twig
msgid "Status"
msgstr "Duru"

#: templates/migration_status.html.twig
msgid "Migrated"
msgstr "Aktarıldı"

#: templates/migration_status.html.twig
msgid "Not Migrated"
msgstr "Aktarılmadı"

#: templates/migration_status.html.twig
msgid "No escalation link to migrate."
msgstr "Aktarılacak bir üste aktarma bağlantısı yok."

#: templates/migration_status.html.twig
msgid "How to Migrate"
msgstr "Nasıl aktarılır"

#: templates/migration_status.html.twig
msgid "Simulate"
msgstr "Benzetim"

#: templates/migration_status.html.twig
msgid "Migrate the group filter to MoreOptions?"
msgstr "Grup süzgeci MoreOptions üzerine aktarılsın mı?"

#: templates/migration_status.html.twig
msgid "Migrate"
msgstr "Aktar"

#: templates/migration_status.html.twig
msgid "Or from the command line:"
msgstr "Ya da komut satırından:"

#: templates/migration_status.html.twig
msgid "Copy command"
msgstr "Komutu kopyala"

#: templates/migration_status.html.twig
msgid "From the GLPI root directory. Add \"--dry-run\" to simulate."
msgstr "GLPI kök klasöründen. Benzerim için \"--dry-run\" ekleyin."

#: templates/migration_status.html.twig
msgid "Links are migrated to the root entity and inherited by sub-entities"
msgstr "Bağlantılar kök birime taşınır ve alt varlıklar tarafından devralınır"

#: templates/migration_status.html.twig
msgid ""
"Users bypassing the filter cannot be migrated: allow profiles in MoreOptions"
" instead"
msgstr "Süzgeçten geçen kullanıcılar aktarılamaz: Bunun yerine MoreOptions üzerinde profillere izin verin"

#: setup.php:68
msgid "Escalade End-Of-Life Updater"
msgstr "Ömrü tamamlanmış Escalade güncelleyici"

#: inc/eolinfo.class.php:167
msgid "The migration failed, all changes have been reverted."
msgstr "Aktarım tamamlanamadı. Tüm değişiklikler geri alındı."

#: inc/eolinfo.class.php:169
#, php-format
msgid ""
"Simulation: %1$d items would be created, %2$d reused. Nothing has been "
"changed."
msgstr "Benzetim: %1$d öge oluşturulacak, %2$d öge yeniden kullanılacak. Hiçbir şey değiştirilmedi."

#: inc/eolinfo.class.php:171
#, php-format
msgid "Migration done: %1$d items created, %2$d reused."
msgstr "Aktarım tamamlandı: %1$d öge oluşturuldu, %2$d öge yeniden kullanıldı."

#: inc/eolinfo.class.php:236 inc/eolinfo.class.php:237
#, php-format
msgid "Deleted group #%d"
msgstr "%d numaralı grup silindi"
